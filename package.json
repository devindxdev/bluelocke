{
  "name": "scriptable",
  "version": "1.0.0",
  "description": "testing",
  "main": "index.js",
  "scripts": {
    "build": "if [ \"${VERCEL:-}\" = \"1\" ]; then npm run build:site; else npm run build:scriptable; fi",
    "build:scriptable": "source ./build.sh; build",
    "build:site": "sh ./scripts/build-site.sh",
    "test:vehicle-images": "node --test scripts/test-vehicle-images.mjs",
    "test:vehicle-loading": "node --test scripts/test-vehicle-loading.mjs",
    "test:vehicle-status": "node --test scripts/test-vehicle-status.mjs",
    "test:us-climate": "node --test scripts/test-us-climate.mjs",
    "test:logs": "node --test scripts/test-logs.mjs",
    "test:auth": "node --test scripts/test-auth-session.mjs",
    "test:user-errors": "node --test scripts/test-user-errors.mjs",
    "test:security": "node --test scripts/test-security.mjs scripts/test-auth-session.mjs scripts/test-logs.mjs",
    "test:app-ui": "node --test scripts/test-app-ui.mjs",
    "prebuild": "npm run lint",
    "lint": "npm run prettier && eslint \"*.ts\" \"src/**/*.ts\" --fix",
    "watch": "source ./build.sh; build_and_watch",
    "prettier": "prettier --log-level warn --write \"*.ts\" \"src/**/*.ts\"",
    "test": "node --test scripts/test-*.mjs",
    "test:europe": "node --test scripts/test-europe-*.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.10.6",
    "@types/scriptable-ios": "^1.7.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rollup": "^4.66.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  }
}
